# Only the reviewed configuration, installer and documentation may enter Git.
# New application directories, histories, collections and caches stay local.
*

!/.gitignore
!/README.md
!/install.ps1
!/starship.toml
!/tests.toml

!/powershell/
!/powershell/init.ps1
!/powershell/install.ps1
!/powershell/installer-functions.ps1
!/powershell/modules/
!/powershell/modules/aliases.ps1
!/powershell/modules/key-bindings.ps1
!/powershell/modules/pyvenv-switcher.ps1
!/powershell/modules/terminal-tools.ps1

!/tests/
!/tests/run.py
!/tests/helpers.ps1

!/gh/
!/gh/config.yml
!/glow/
!/glow/glow.yml
!/lazydocker/
!/lazydocker/config.yml
!/lazygit/
!/lazygit/config.yml
!/lazygit/delta.gitconfig

!/micro/
!/micro/settings.json
!/micro/bindings.json
!/micro/colorschemes/
!/micro/colorschemes/catppuccin-mocha.micro

!/posting/
!/posting/config.yaml
!/posting/themes/
!/posting/themes/catppuccin-mocha.yaml

!/yazi/
!/yazi/init.lua
!/yazi/keymap.toml
!/yazi/package.toml
!/yazi/theme.toml
!/yazi/yazi.toml
!/yazi/plugins/
!/yazi/plugins/piper.yazi/
!/yazi/plugins/toggle-pane.yazi/
!/yazi/plugins/yamb.yazi/
!/yazi/plugins/preview-arrow.yazi/
!/yazi/plugins/*/main.lua
!/yazi/plugins/*/LICENSE
!/yazi/plugins/*/README.md
!/yazi/flavors/
!/yazi/flavors/catppuccin-mocha.yazi/
!/yazi/flavors/catppuccin-mocha.yazi/flavor.toml
!/yazi/flavors/catppuccin-mocha.yazi/tmtheme.xml
!/yazi/flavors/catppuccin-mocha.yazi/LICENSE
!/yazi/flavors/catppuccin-mocha.yazi/LICENSE-tmtheme
!/yazi/flavors/catppuccin-mocha.yazi/README.md
